# CortexAI frontend environment (Vite)
#
# VITE_* values are baked into the JavaScript bundle at build time and are
# visible to anyone who opens the site, so only public keys belong here.
# On Vercel, set them under Project -> Settings -> Environment Variables and
# redeploy after changing them.

# Leave EMPTY in production. The app then calls /api/* on its own domain and
# vercel.json rewrites it to Render, which keeps the login cookie first-party
# (Safari and Firefox block third-party cookies). If your Render URL is not
# https://cortexai-api-wrof.onrender.com, update the destination in vercel.json.
#
# Local dev: empty works too (vite.config.js proxies /api to localhost:8000),
# or set http://localhost:8000 to call the gateway directly.
# Only set a full URL to call an API on another origin directly.
VITE_API_URL=

# Firebase Web API key (public). Firebase console -> Project settings ->
# General -> Your apps -> Web app -> apiKey.
VITE_FIREBASE_API_KEY=

# Razorpay Key Id (public part only, never the secret). Must match the
# backend's RAZORPAY_KEY_ID. rzp_test_... in test mode, rzp_live_... in live.
VITE_RAZORPAY_KEY_ID=
