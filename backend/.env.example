# CortexAI backend environment
#
# Production (Render): one web service runs `start-all.js`, which starts the
# gateway plus the auth, chat, agent and billing services. Set every variable
# below on that one service.
#
# Local dev: each service reads its own .env (backend/gateway/.env,
# backend/services/<name>/.env). Copy the variables a service needs from here,
# and also set PORT and the *_SERVICE URLs listed at the bottom.
#
# Never commit real values. .env files are git-ignored.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Public port the gateway listens on. Render sets this automatically.
PORT=8000

# "production" turns on Secure + SameSite=None session cookies (required when
# the frontend and API are on different domains). Leave unset for local dev.
NODE_ENV=production

# Frontend origin(s) allowed to call the API with cookies (CORS).
# Comma-separated, no trailing slash. Example: your Vercel URL plus localhost.
FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. start-all.js swaps the database name per
# service (auth, chat, billing), so any database path here is fine.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cortexai

# Optional: give a service its own full connection string instead.
# MONGODB_URI_AUTH=
# MONGODB_URI_CHAT=
# MONGODB_URI_BILLING=

# Redis for login sessions, chat memory cache and rate limits.
# On Render this comes from the Key Value instance (render.yaml wires it).
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Shared secret for service-to-service calls (update-plan, deduct-credits,
# refund-credits, save-message). Any long random string, same for every
# service. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Firebase Admin service account, as the whole JSON key on ONE line.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Used by auth to verify Google sign-in tokens.
FIREBASE_SERVICE_ACCOUNT=

# Local alternative to the above: path to the JSON key file.
# Defaults to backend/services/auth/serviceAccountKey.json.
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional. Session cookie SameSite value; defaults to "none" in production
# and "strict" otherwise. "none" always forces Secure.
# COOKIE_SAMESITE=

# ---------------------------------------------------------------------------
# AI providers (agent service; read directly by the LangChain SDKs)
# ---------------------------------------------------------------------------

# Groq: chat, search answers, agent router, coding fallback. console.groq.com
GROQ_API_KEY=

# Google AI Studio: Gemini image analysis + PDF embeddings. aistudio.google.com
GOOGLE_API_KEY=

# OpenRouter: coding agent (DeepSeek). openrouter.ai/keys
OPENROUTER_API_KEY=

# Tavily: web search agent. app.tavily.com
TAVILY_API_KEY=

# Optional. How many ~2,000-character chunks of an uploaded PDF are searched
# (default 90, roughly 50-60 pages). Every chunk costs one Gemini embedding
# request and the free tier allows 100 per minute for the whole app, so a
# second large PDF within the same minute gets a "try again" message.
# Raise it on a paid key.
# PDF_MAX_CHUNKS=90

# ---------------------------------------------------------------------------
# AWS S3 (generated PDFs, PPTs and images)
# ---------------------------------------------------------------------------

# Bucket region, e.g. eu-north-1.
AWS_REGION=
# IAM user with s3:PutObject and s3:GetObject on the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket name only (not a URL).
AWS_BUCKET_NAME=

# ---------------------------------------------------------------------------
# Razorpay (billing service)
# ---------------------------------------------------------------------------

# Dashboard -> Account & Settings -> API Keys. rzp_test_... for test mode.
# The key id must match the frontend's VITE_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard -> Webhooks -> add https://<api-host>/api/billing/webhook with
# events payment.captured and order.paid; paste the secret you chose there.
# Without it the webhook returns 503 and only the checkout callback credits.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Tuning (optional, start-all.js)
# ---------------------------------------------------------------------------

# Internal ports for the services behind the gateway (defaults 8001-8004).
# AUTH_PORT=8001
# CHAT_PORT=8002
# AGENT_PORT=8003
# BILLING_PORT=8004

# V8 heap cap per process in MB, to stay inside a 512 MB instance.
# Defaults: gateway 48, auth 64, chat 48, agent 160, billing 48.
# NODE_HEAP_MB_AGENT=160

# ---------------------------------------------------------------------------
# Set automatically by start-all.js; only needed in local per-service .env
# ---------------------------------------------------------------------------

# Where the gateway and agent/billing reach the other services.
# AUTH_SERVICE=http://localhost:8001
# CHAT_SERVICE=http://localhost:8002
# AGENT_SERVICE=http://localhost:8003
# BILLING_SERVICE=http://localhost:8004
# Interface the internal services bind to (127.0.0.1 behind the gateway).
# HOST=
